# Enable RedMagic GameAssist Plugins (usually reserved for RedMagic phones)
ro.vendor.feature.zte_feature_gameassist_plugin_redmagic_broadcast=true
ro.vendor.feature.zte_feature_gameassist_plugin_redmagic_elvesaid=true
ro.vendor.feature.zte_feature_redmagickyi_tile_main=true
ro.vendor.feature.zte_feature_gameassist_plugin_biablo=true

# Enable AI Model Services & Smart MindSync
ro.vendor.feature.zte_feature_ai_model_service=true
ro.vendor.feature.zte_feature_mindsync_samrt_start=true
ro.vendor.feature.zte_feature_mindsync_cloud_update_enabled=true

# Enable Complex UI Animations & Window Replies
ro.vendor.feature.myos_feature_complex_animation=true
ro.vendor.feature.mfv_feature_windowreply=true
ro.vendor.feature.mfv_feature_windowreply_abroad=true
ro.vendor.feature.mfv_feature_chooser=true

# Enable Advanced Network Features (VoNR / 5G Voice)
persist.radio.is_vonr_enabled_0=true

# Enable Live Island Water Drop style
ro.vendor.feature.zte_feature_live_island_water_drop=true

# Enable SystemUI Doze / Peek
ro.vendor.feature.sysui_doze_mfv=true

# Performance tweaks
ro.vendor.feature.zte_feature_defragment=true
ro.vendor.lmk.kill_heaviest_task_enabled=true

# Unlock HiFi Audio & Spatial Audio
persist.vendor.audio.hifi_enabled=true
ro.audio.spatializer_enabled=true

# Smooth Scrolling & UI Responsiveness
persist.sys.ss.predict=true
persist.sys.ss.scroll=true
persist.sys.choreographer.pre_animation_load=true

# Display Features
ro.surface_flinger.has_wide_color_display=true
ro.vendor.feature.sysui_show_hd_disabled=true

# Launcher & Charging Animations
ro.launcher.dynamic=true
ro.vendor.feature.zte_charger_mfv_v4=true
ro.vendor.feature.zte_charger_mfv_v4_adapt=true

# System Hidden Features
ro.vendor.feature.zte_feature_allow_transform_switch=true
ro.vendor.feature.zte_feature_heartyservice=true
ro.vendor.feature.zte_feature_internal_app_hide=true
ro.vendor.feature.zte_enable_filebrowser=true

# Security, Unlocking & Fingerprint
ro.vendor.feature.skip_password=true
ro.vendor.feature.default_value_direct_unlock=true
ro.vendor.feature.zte_init_lcd_while_fingerdown=true

# System UI, Display & Launcher Animations
ro.vendor.feature.zte_feature_show_immersive_mode_comfirmation=true
ro.vendor.feature.zte_feature_font_hyzhengyuan=true
ro.vendor.feature.launcher_open_close_app_simple_anim=true

# Performance, Memory & App Launch
ro.vendor.feature.zte_use_compaction=true
ro.vendor.feature.quickrtapp=true
ro.vendor.feature.zte_feature_autolaunch_white_list_gms=true

# Network, Audio & Translation Features
ro.vendor.feature.zte_feature_streamer_predict_support=true
ro.vendor.feature.zte_audio_voice_translation_mifavor=true
ro.vendor.feature.feature_sprd_enable_fiveg_power_save_by_default=true

# Hardware, Charging & LED
ro.vendor.feature.zte_charger_mfv_v3=true
ro.vendor.feature.zte_led_mono_chrome=true

# Miscellaneous Core Features
ro.vendor.feature.zte_feature_xml_capacity=true
ro.vendor.feature.zte_feature_transform_legacy=true